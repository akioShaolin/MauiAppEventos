<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:models="clr-namespace:MauiAppEventos.Models" x:DataType="models:Evento"
 x:Class="MauiAppEventos.Views.ResumoEvento" Title="Resumo do evento">
 <ScrollView>
  <VerticalStackLayout Padding="20,28" Spacing="20" MaximumWidthRequest="600" HorizontalOptions="Fill">
   <Label Text="TUDO PRONTO PARA CONFERIR" TextColor="#C4B5FD" FontSize="12" CharacterSpacing="2" />
   <Label Text="Seu evento, em detalhes." Style="{StaticResource PageTitle}" />
   <Border Style="{StaticResource Card}">
    <VerticalStackLayout Spacing="12">
     <Label Text="{Binding Nome}" FontSize="26" FontFamily="OpenSansSemibold" LineBreakMode="WordWrap" />
     <Label Text="Local" Style="{StaticResource Caption}" />
     <Label Text="{Binding Local}" />
     <BoxView HeightRequest="1" Color="#DDD6FE" Margin="0,8" />
     <Label Text="Data de início" Style="{StaticResource Caption}" />
     <Label Text="{Binding DataInicio, StringFormat='{}{0:dd/MM/yyyy}'}" />
     <Label Text="Data de término" Style="{StaticResource Caption}" />
     <Label Text="{Binding DataTermino, StringFormat='{}{0:dd/MM/yyyy}'}" />
     <Label Text="Duração" Style="{StaticResource Caption}" />
     <Label Text="{Binding DuracaoDias, StringFormat='{}{0} dias'}" />
     <Label Text="Participantes" Style="{StaticResource Caption}" />
     <Label Text="{Binding NumeroParticipantes, StringFormat='{}{0} participantes'}" />
     <Label Text="Custo por participante" Style="{StaticResource Caption}" />
     <Label Text="{Binding CustoPorParticipante, StringFormat='{}{0:C}'}" />
    </VerticalStackLayout>
   </Border>
   <Border Style="{StaticResource Card}" BackgroundColor="#EDE9FE">
    <VerticalStackLayout Spacing="8">
     <Label Text="INVESTIMENTO TOTAL" TextColor="#6D28D9" FontFamily="OpenSansSemibold" FontSize="12" CharacterSpacing="2" />
     <Label Text="{Binding CustoTotal, StringFormat='{}{0:C}'}" FontSize="36" FontFamily="OpenSansSemibold" TextColor="#5B21B6" LineBreakMode="WordWrap" />
     <Label Text="Participantes × custo individual" Style="{StaticResource Caption}" />
    </VerticalStackLayout>
   </Border>
   <Button Text="Voltar" Style="{StaticResource PrimaryButton}" Clicked="Voltar" />
  </VerticalStackLayout>
 </ScrollView>
</ContentPage>
