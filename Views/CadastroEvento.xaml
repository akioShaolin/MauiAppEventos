<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 x:Class="MauiAppEventos.Views.CadastroEvento" Title="Novo evento">
 <ScrollView>
  <VerticalStackLayout Padding="20,28" Spacing="20" MaximumWidthRequest="600" HorizontalOptions="Fill">
   <Label Text="AGENDA 15  /  EVENTOS" TextColor="#C4B5FD" FontSize="12" CharacterSpacing="2" />
   <Label Text="Grandes encontros&#10;começam aqui." Style="{StaticResource PageTitle}" />
   <Label Text="Organize os detalhes e confira o investimento do seu próximo evento." TextColor="#DDD6FE" />
   <Border Style="{StaticResource Card}">
    <VerticalStackLayout Spacing="12">
     <Label Text="Detalhes do evento" FontFamily="OpenSansSemibold" FontSize="20" />
     <Label Text="Nome do evento" />
     <Entry x:Name="ent_nome" Placeholder="Ex.: Encontro de tecnologia" MaxLength="200" />
     <Label Text="Local do evento" />
     <Entry x:Name="ent_local" Placeholder="Ex.: Auditório central" MaxLength="300" />
     <Label Text="Participantes" />
     <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
      <Button x:Name="btn_diminuir" Text="−" Style="{StaticResource CounterButton}" Clicked="DiminuirParticipantes" SemanticProperties.Description="Diminuir participantes" />
      <Label x:Name="lbl_participantes" Grid.Column="1" Text="1" FontSize="24" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
      <Button x:Name="btn_aumentar" Grid.Column="2" Text="+" Style="{StaticResource CounterButton}" Clicked="AumentarParticipantes" SemanticProperties.Description="Aumentar participantes" />
     </Grid>
     <Label Text="Data de início" />
     <DatePicker x:Name="dtp_inicio" DateSelected="InicioSelecionado" />
     <Label Text="Data de término" />
     <DatePicker x:Name="dtp_termino" />
     <Label Text="O término deve ser posterior ao início." Style="{StaticResource Caption}" />
     <Label Text="Custo por participante (R$)" />
     <Entry x:Name="ent_custo" Keyboard="Numeric" Placeholder="0,00" />
     <Label Text="Use vírgula para os centavos. Eventos gratuitos: 0." Style="{StaticResource Caption}" />
     <Button x:Name="btn_resumo" Text="Ver resumo" Clicked="VerResumo" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" />
    </VerticalStackLayout>
   </Border>
  </VerticalStackLayout>
 </ScrollView>
</ContentPage>
